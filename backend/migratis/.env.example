DEBUG=True
USE_SQLITE=True

# PostgreSQL (only used when USE_SQLITE=False)
# To use Postgres: set USE_SQLITE=False above, keep these in sync with the
# base-db service, then start with:  docker compose --profile postgres up --build
DB_NAME=migratis
DB_USER=migratis
DB_PASSWORD=change-me
DB_HOST=base-db
DB_PORT=5432

# Email
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_SENDER=
# Set both to send over Mailjet's HTTPS API instead of SMTP — needed where the
# host blocks outbound SMTP ports. Each deploy supplies its own account.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# Stripe (only used when SUBSCRIPTION=True in frontend/src/settings.js)
STRIPE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_KEY=

# Django
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost,host.docker.internal
CORS_ORIGIN_WHITELIST=http://127.0.0.1:3002
FRONTEND_URL=http://127.0.0.1:3002
BACKEND_URL=http://127.0.0.1:8004
MEDIA_FULL_URL=http://127.0.0.1:8004/media/
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3002
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
NO_SUBSCRIPTION=True

# Installer — set False to disable the /installer/ API and page entirely.
# Keep in sync with INSTALLER in frontend/src/settings.js.
INSTALLER=True

# Who may call the installer's package endpoints, which apply caller-supplied
# code into this running project. Empty (the default) means LOOPBACK-ONLY: only
# a caller on this host is accepted. Setting a value switches them to header
# auth instead — an off-box agent then sends it as `X-Installer-Token`.
#
# Note "instead": a configured token REPLACES loopback access rather than adding
# to it, so an on-box caller must send the header too. Restart the backend after
# changing this; it is read at startup.
# INSTALLER_AGENT_TOKEN=

# Which Migratis this template's installer lists and downloads applications
# from. A bare ORIGIN — scheme and host, no path: the installer appends
# `/backend/api/...` itself, so a value ending in /backend would compose
# https://migratis.ai/backend/backend/api/... and 404. A trailing slash is fine.
#
# The hosted instance is the default. Point it at a Migratis running on this
# same host instead — reachable from INSIDE the container, so host.docker.internal
# on Linux/Mac with Docker, not 127.0.0.1 — when developing the two together:
#   MIGRATIS_BACKEND_URL=http://host.docker.internal:8000
#
# The installer's own connect form overrides this per session, so a single base
# can be pointed at a different Migratis without editing the file.
MIGRATIS_BACKEND_URL=https://migratis.ai


# ═══════════════════════════════════════════════════════════════════════════
# Everything below is OPTIONAL and shown at its default.
#
# Commented out on purpose. Each line states what settings.py already does, so
# copying this file verbatim changes nothing — and, more usefully, an operator
# who never uncomments one keeps following the default when it changes, instead
# of silently pinning today's value in their own .env forever. Uncomment only
# what you are actually deciding.
#
# Three of these became settable at all on 2026-09-08 (ROUTING_BREAKER_SECONDS,
# SUBSCRIPTION_TRIAL, ENTITLEMENT_PROVIDER): they were read with a getattr
# default that settings.py never declared, so setting them did nothing. If you
# add a knob, declare it in settings.py — `manage.py check` fails otherwise.
# ═══════════════════════════════════════════════════════════════════════════

# ── Road-following routes (optional `routing` module) ──────────────────────
# Only consulted when the module is installed. Which engine adapter to use, and
# where it lives. With no URL the module is inert: a `route` field still stores
# the line the user traced, it just is not snapped to roads.
# ROUTING_ENGINE=valhalla
# ROUTING_ENGINE_URL=
# API key, for an engine you rent rather than run (e.g. ROUTING_ENGINE=ors).
# ROUTING_ENGINE_KEY=
# Seconds before a snap request is abandoned.
# ROUTING_ENGINE_TIMEOUT=20
# How long the breaker stays tripped after the engine fails.
# ROUTING_BREAKER_SECONDS=300
# Dotted path deciding who may call POST /routing/snap. Empty leaves it OPEN,
# which is the right posture here: an installed app calls its own operator's
# engine, and gating it would make the map work for the owner and silently do
# nothing for everyone else. migratis.ai names one because it meters a quota.
# ROUTING_SNAP_AUTHORIZER=
# Per-IP ceiling, requests/minute. 0 = no limit.
# ROUTING_SNAP_RATE_PER_MINUTE=0

# ── External data sources (optional `datasource` module) ───────────────────
# Path to the generated app's datasources.json. Written by that app's
# settings_patch.py, which runs AFTER this file — leave it alone.
# DATASOURCE_DECLARATIONS=
# As with routing: empty means open, and for the same reason.
# DATASOURCE_AUTHORIZER=
# Dotted path to a host denylist, and a static comma-separated fallback. The
# module refuses a host on either. Empty denies nothing — the address checks
# still decide where a packet may go; this decides who you refuse on purpose.
# DATASOURCE_HOST_POLICY=
# DATASOURCE_DENIED_HOSTS=
# Per-caller ceiling, requests/minute. 0 = no limit.
# DATASOURCE_RATE_PER_MINUTE=0
# Per-application ceiling per day. The meter is YOUR key's, so this is the one
# worth setting if a source bills you per call.
# DATASOURCE_DAILY_PER_APPLICATION=2000
# How long the breaker stays tripped after a source fails.
# DATASOURCE_BREAKER_SECONDS=300
#
# The KEY for each declared source is not listed here: it is named per source
# as DATASOURCE_<SLUG>_KEY, so the installer prompts for the ones an
# application actually declares and names any still missing after the install.

# ── Subscription ──────────────────────────────────────────────────────────
# Free-trial eligibility. False means nobody is trial-eligible: the Checkout
# builder omits the trial period and user.trial is False everywhere.
# SUBSCRIPTION_TRIAL=True
# Dotted path to an entitlement provider; empty selects the built-in
# subscription one. This is how the monetization model is swapped.
# ENTITLEMENT_PROVIDER=

# ── Paths ─────────────────────────────────────────────────────────────────
# The frontend src/ directory AS SEEN FROM INSIDE THE CONTAINER — the installer
# writes generated modules there. Change it only if you mount the frontend
# somewhere other than /frontend.
# FRONTEND_SRC_DIR=/frontend/src
